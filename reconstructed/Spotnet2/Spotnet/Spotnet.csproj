<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Spotnet</AssemblyName>
    <RootNamespace>Spotnet</RootNamespace>
    <ApplicationIcon>Resources\ImagesInternal\spotnet.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="4.6.0" />
    <!-- Edge WebView2 is the only browser engine. The x64 loader is selected by the build. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <!-- SQLite provider and native interop. Replaces the loose 1.0.94 DLL from 2014:
         ten years of engine fixes (including WAL recovery and corruption bugs), FTS5,
         and a much better query planner. The .Core package stages x86/ and x64/ copies
         of SQLite.Interop.dll and resolves the right one at runtime, so this is also one
         of the two hard blockers on moving off x86.
         These binaries are not built with SQLITE_ENABLE_FTS5; the interop carries
         FTS5 as a loadable extension instead, registered per connection by
         Fts5Module. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- Used only for NNTP's zlib-compressed header responses. ZIP archive extraction
         uses the traversal-safe System.IO.Compression boundary in SafeZip. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="5.5.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <!-- Maintained 64-bit media stack replacing the obsolete x86-only wrapper. -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <!-- Formerly loose DLLs in lib/. Same major versions as the assemblies they
         replace, so this is a sourcing change and not a library upgrade. -->
    <PackageReference Include="MahApps.Metro" Version="1.6.5" />
    <!-- Brings GalaSoft.MvvmLight, its Extras, CommonServiceLocator and
         System.Windows.Interactivity in one package. -->
    <PackageReference Include="MvvmLightLibs" Version="5.4.1.1" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="3.5.0" />
    <PackageReference Include="FileCache.Signed" Version="2.2.0" />
    <PackageReference Include="Starksoft.Aspen" Version="1.1.8" />
    <!-- A framework assembly on .NET Framework, a package from .NET Core onward.
         Taking it from the package now means the reference survives a retarget. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <ProjectReference Include="..\Spotnet.Enc\Spotnet.Enc.csproj" />
  </ItemGroup>

  <!-- Squirrel 0.9.2 and the assemblies it loads at runtime. No NuGet release
       matches this version, and the updater is woven through startup, so these
       stay vendored until the updater itself is revisited. -->
  <ItemGroup>
    <Reference Include="ClickOnceUninstaller">
      <HintPath>..\lib\ClickOnceUninstaller.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="DeltaCompressionDotNet">
      <HintPath>..\lib\DeltaCompressionDotNet.dll</HintPath>
      <Private>True</Private>
    </Reference>
<Reference Include="Microsoft.Deployment.WindowsInstaller">
      <HintPath>..\lib\Microsoft.Deployment.WindowsInstaller.dll</HintPath>
      <Private>True</Private>
    </Reference>
<Reference Include="Microsoft.Web.XmlTransform">
      <HintPath>..\lib\Microsoft.Web.XmlTransform.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>..\lib\Mono.Cecil.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="NuGet.Core">
      <HintPath>..\lib\NuGet.Core.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Splat">
      <HintPath>..\lib\Splat.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Squirrel, Version=0.9.2.0, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>..\lib\Squirrel.dll</HintPath>
      <Private>True</Private>
    </Reference>
</ItemGroup>

  <!-- Framework Assemblies -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <!-- ServiceManager and VPNStatusChecker query Windows services. On .NET Core
         and later this comes from the System.ServiceProcess.ServiceController package. -->
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <!-- Embedded Text & Data Resources -->
  <ItemGroup>
    <EmbeddedResource Update="Spotnet.Properties.Categories.resx" LogicalName="Spotnet.Properties.Categories.resources" />
    <EmbeddedResource Update="Spotnet.Properties.Resources.resx" LogicalName="Spotnet.Properties.Resources.resources" />
    <EmbeddedResource Update="Spotnet.Properties.Words.resx" LogicalName="Spotnet.Properties.Words.resources" />
    <!-- Dutch satellite resources. The 2.0 binary shipped nl\Spotnet.resources.dll; the
         reconstruction only recovered the dumps, so every Dutch install silently fell back
         to the neutral English table. These rebuild nl\Spotnet.resources.dll.
         The culture belongs in the logical name: ResourceManager.GetResourceFileName appends
         the culture for non-invariant lookups, so a satellite holding a name without it loads
         but resolves nothing. This matches the 2.0 binary's own satellite. -->
    <EmbeddedResource Update="Spotnet.Properties.Categories.nl.resx" LogicalName="Spotnet.Properties.Categories.nl.resources" Culture="nl" />
    <EmbeddedResource Update="Spotnet.Properties.Words.nl.resx" LogicalName="Spotnet.Properties.Words.nl.resources" Culture="nl" />
    <EmbeddedResource Include="Spotnet.Resources.badwords.txt" LogicalName="Spotnet.Resources.badwords.txt" />
    <EmbeddedResource Include="Spotnet.Resources.null_modulus.txt" LogicalName="Spotnet.Resources.null_modulus.txt" />
    <Resource Include="Resources\ImagesInternal\**\*" />
    <Resource Include="Resources\fontawesome-webfont.ttf" />
    <Resource Include="Resources\snow-fall.js" />
  </ItemGroup>

  <!-- Copy Native Binaries & Asset Folders to Output -->
  <ItemGroup>
    <!-- The post-processing helpers and the Squirrel updater stub. Spotnet.exe is
         excluded: lib/ still holds the decompiled 2.0 reference binary, and copying it
         here would put it in the output next to - or over - the one just built. -->
    <None Include="$(MSBuildProjectDirectory)\..\lib\*.exe" Exclude="$(MSBuildProjectDirectory)\..\lib\Spotnet.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <None Include="Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\ReleaseNotes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
