  <!-- Framework Assemblies -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <!-- Embedded Text & Data Resources -->
  <ItemGroup>
    <EmbeddedResource Update="Spotnet.Properties.Categories.resx" LogicalName="Spotnet.Properties.Categories.resources" />
    <EmbeddedResource Update="Spotnet.Properties.Resources.resx" LogicalName="Spotnet.Properties.Resources.resources" />
    <EmbeddedResource Update="Spotnet.Properties.Words.resx" LogicalName="Spotnet.Properties.Words.resources" />
    <EmbeddedResource Include="Spotnet.Resources.badwords.txt" LogicalName="Spotnet.Resources.badwords.txt" />
    <EmbeddedResource Include="Spotnet.Resources.null_modulus.txt" LogicalName="Spotnet.Resources.null_modulus.txt" />
    <Resource Include="Resources\ImagesInternal\**\*" />
    <Resource Include="Resources\fontawesome-webfont.ttf" />
    <Resource Include="Resources\snow-fall.js" />
  </ItemGroup>

  <!-- Copy Native Binaries & Asset Folders to Output -->
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\..\lib\*.exe;$(MSBuildProjectDirectory)\..\lib\*.pak;$(MSBuildProjectDirectory)\..\lib\SQLite.Interop.dll;$(MSBuildProjectDirectory)\..\lib\awesomium.dll;$(MSBuildProjectDirectory)\..\lib\icudt.dll;$(MSBuildProjectDirectory)\..\lib\libEGL.dll;$(MSBuildProjectDirectory)\..\lib\libGLESv2.dll;$(MSBuildProjectDirectory)\..\lib\avcodec-53.dll;$(MSBuildProjectDirectory)\..\lib\avformat-53.dll;$(MSBuildProjectDirectory)\..\lib\avutil-51.dll;$(MSBuildProjectDirectory)\..\lib\xinput9_1_0.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <None Include="Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\ReleaseNotes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>