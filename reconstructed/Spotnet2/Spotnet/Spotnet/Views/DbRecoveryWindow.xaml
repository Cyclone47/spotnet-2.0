<controls:MetroWindow x:Class="Spotnet.Views.DbRecoveryWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      Title="Spotnet Database Recovery &amp; Repair"
                      Height="380" Width="520"
                      WindowStartupLocation="CenterScreen"
                      ResizeMode="NoResize"
                      ShowInTaskbar="True"
                      Topmost="True"
                      BorderBrush="#007ACC"
                      BorderThickness="1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="⚠️" FontSize="32" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Database Startup Issue Detected" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock x:Name="ReasonTextBlock" Text="Database startup took longer than 20 seconds or reported a connection issue." 
                           FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Description -->
        <TextBlock Grid.Row="1" Text="Choose how you would like Spotnet to handle your database:" 
                   FontSize="13" Foreground="#444444" Margin="0,0,0,15"/>

        <!-- Action Buttons Grid -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <!-- 1. Quick Repair Button -->
            <Button x:Name="RepairButton" Click="RepairButton_Click" Height="54" Margin="0,0,0,10"
                    HorizontalContentAlignment="Left" Padding="12,6" Background="#E6F2FB" BorderBrush="#007ACC">
                <StackPanel>
                    <TextBlock Text="🔧 Quick Repair (Recommended ~2-5s)" FontWeight="Bold" FontSize="13" Foreground="#005A9E"/>
                    <TextBlock Text="Fixes journal locks &amp; sync watermarks without losing spots or comments." FontSize="11" Foreground="#555555"/>
                </StackPanel>
            </Button>

            <!-- 2. Clean Reset Button -->
            <Button x:Name="ResetButton" Click="ResetButton_Click" Height="54" Margin="0,0,0,10"
                    HorizontalContentAlignment="Left" Padding="12,6" Background="#FFF5E6" BorderBrush="#FF9900">
                <StackPanel>
                    <TextBlock Text="🧹 Clean Reset (Instant - Creates .bak backup)" FontWeight="Bold" FontSize="13" Foreground="#B35900"/>
                    <TextBlock Text="Safely backs up current database and starts fresh from your provider." FontSize="11" Foreground="#555555"/>
                </StackPanel>
            </Button>

            <!-- 3. Close Button -->
            <Button x:Name="CloseButton" Click="CloseButton_Click" Height="42" Margin="0,0,0,5"
                    HorizontalContentAlignment="Left" Padding="12,6" Background="#F2F2F2" BorderBrush="#CCCCCC">
                <StackPanel>
                    <TextBlock Text="❌ Close Spotnet" FontWeight="Bold" FontSize="12" Foreground="#333333"/>
                    <TextBlock Text="Exit Spotnet without making any database changes." FontSize="10" Foreground="#777777"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Status / Progress Info -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="" FontSize="11" Foreground="#007ACC" VerticalAlignment="Center"/>
            <ProgressBar x:Name="ProgressBarControl" IsIndeterminate="True" Height="4" Visibility="Collapsed" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</controls:MetroWindow>
