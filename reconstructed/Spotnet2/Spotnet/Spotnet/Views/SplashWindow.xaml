<Window x:Class="Spotnet.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="680" Height="440"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/ImagesInternal/spotnet.ico">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Floating spotlight logo with transparent background and subtle shadow -->
        <Image Grid.Row="0"
               Source="/Resources/ImagesInternal/splashlogo.png"
               Stretch="Uniform"
               MaxHeight="310"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.45"/>
            </Image.Effect>
        </Image>

        <!-- Floating translucent progress container below the logo -->
        <StackPanel Grid.Row="1" Width="440" HorizontalAlignment="Center" Margin="0,0,0,15">
            <!-- Localized status text with soft shadow for readability over any background -->
            <TextBlock x:Name="StatusText"
                       Text="Opstarten..."
                       Foreground="#FFFFFFFF"
                       FontSize="13"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#000000" Opacity="0.85"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Sleek progress capsule -->
            <Border Height="6"
                    CornerRadius="3"
                    Background="#55000000"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <Border x:Name="ProgressFill"
                        HorizontalAlignment="Left"
                        Height="6"
                        Width="0"
                        CornerRadius="3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0088FF" Offset="0"/>
                            <GradientStop Color="#FF00E5FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>

            <!-- Subtle version tag -->
            <TextBlock x:Name="VersionText"
                       Text="v2.0.0.284"
                       Foreground="#99FFFFFF"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Right"
                       Margin="0,4,2,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.75"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
