<UserControl x:Class="Spotnet.Controls.VPNInstallStatusWarning" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:local="clr-namespace:Spotnet.Controls" Width="310" Height="Auto" DataContext="{Binding StatusBar, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="35" />
        <Setter Property="Foreground" Value="#FFF5F5F5" />
      </Style>
      <Storyboard x:Key="fadeOutControl">
        <ObjectAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Visibility">
          <DiscreteObjectKeyFrame KeyTime="0">
            <ObjectKeyFrame.Value>
              <Visibility>Visible</Visibility>
            </ObjectKeyFrame.Value>
          </DiscreteObjectKeyFrame>
        </ObjectAnimationUsingKeyFrames>
        <DoubleAnimation BeginTime="0:0:0" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5" />
        <ObjectAnimationUsingKeyFrames BeginTime="0:0:0.5" Storyboard.TargetProperty="Visibility">
          <DiscreteObjectKeyFrame KeyTime="0">
            <ObjectKeyFrame.Value>
              <Visibility>Collapsed</Visibility>
            </ObjectKeyFrame.Value>
          </DiscreteObjectKeyFrame>
        </ObjectAnimationUsingKeyFrames>
      </Storyboard>
      <Storyboard x:Key="fadeInControl">
        <ObjectAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetProperty="Visibility">
          <DiscreteObjectKeyFrame KeyTime="0">
            <ObjectKeyFrame.Value>
              <Visibility>Visible</Visibility>
            </ObjectKeyFrame.Value>
          </DiscreteObjectKeyFrame>
        </ObjectAnimationUsingKeyFrames>
        <DoubleAnimation BeginTime="0:0:0" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
        <ObjectAnimationUsingKeyFrames BeginTime="0:0:0.5" Storyboard.TargetProperty="Visibility">
          <DiscreteObjectKeyFrame KeyTime="0">
            <ObjectKeyFrame.Value>
              <Visibility>Visible</Visibility>
            </ObjectKeyFrame.Value>
          </DiscreteObjectKeyFrame>
        </ObjectAnimationUsingKeyFrames>
      </Storyboard>
      <Storyboard x:Key="FadeIn">
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.Opacity)">
          <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
          <SplineDoubleKeyFrame KeyTime="00:00:00.6" Value="1" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <Storyboard x:Key="FadeOut" Completed="OnFadeOutCompleted">
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="(UIElement.Opacity)">
          <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
          <SplineDoubleKeyFrame KeyTime="00:00:00.4" Value="0" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <Color x:Key="BrushLightGreen">#FF32EA28</Color>
      <Style x:Key="buttonHover" TargetType="{x:Type Button}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" BorderThickness="1" BorderBrush="#FF5397D1" CornerRadius="3">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="border" Property="Border.BorderBrush" Value="#00FFFFFF" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#FF5397D1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <FrameworkElement.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Name="FadeInBeginStoryboard" Storyboard="{StaticResource FadeIn}" />
    </EventTrigger>
  </FrameworkElement.Triggers>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Name="LayoutRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto" CornerRadius="5" Background="{StaticResource HighlightBrush}" BorderThickness="0" Margin="0,0,0,0" Visibility="{Binding Path=StatusWarningIsVisible, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=MeControl, Mode=Default}" MouseLeave="LayoutRoot_OnMouseLeave">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="8,4,8,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Margin="55,0,20,3" FontSize="15" Text="{Binding VPNWarningPopupTitle, Mode=OneWay}" />
          <TextBlock Name="CloseIcon" Grid.Column="1" FontSize="18" TextAlignment="Center" Text="" Foreground="#FFF5F5F5" Style="{StaticResource FontAwesome}" Cursor="Hand" ToolTipService.HasDropShadow="True" ToolTipService.Placement="Top" ToolTip="{Binding HelpIconToolTip, Mode=OneWay}" MouseDown="CloseIcon_MouseDown" />
        </Grid>
        <StackPanel Grid.Row="1" Background="#FFFF80">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Grid.Column="0" Height="60" Width="50">
              <TextBlock Height="40" Width="40" FontSize="40" TextAlignment="Center" Style="{StaticResource FontAwesome}" Text="{Binding VPNWarningPopupIcon, Mode=OneWay}" Foreground="{Binding VPNWarningPopupIconForeground, Mode=OneWay}" />
            </DockPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="15,5,15,3" Height="auto" VerticalAlignment="Center">
              <TextBlock Name="WarningText" Foreground="#FF000000" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding VPNWarningPopupContent, Mode=OneWay}" />
              <TextBlock Name="DownloadStatusMsg" Text="{x:Static p:Words.VPNInstallerDownloading}" Foreground="#FF000000" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Background="#FFFF80">
          <Grid Margin="50,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="15,5,15,3" Grid.Column="0" Height="40">
              <TextBlock FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Hyperlink NavigateUri="https://www.spotnet.tk/vpn/" TargetName="_blank" BaselineAlignment="Bottom" RequestNavigate="Hyperlink_RequestNavigate">
                  <Run Text="{x:Static p:Words.VPNMoreInfoText}" />
                </Hyperlink>
              </TextBlock>
            </DockPanel>
            <DockPanel Name="DockInstallButton" Grid.Row="0" Grid.Column="1" Margin="15,5,15,3" Height="40">
              <Button Name="InstallVPNClient" Content="{x:Static p:Words.InstallVPNClient}" Click="InstallVPNClient_Click" />
            </DockPanel>
            <DockPanel Name="DockStartButton" Grid.Row="0" Grid.Column="1" Margin="15,5,15,3" Height="40" Visibility="Collapsed">
              <Button Name="StartVPNClient" Style="{StaticResource buttonHover}" Height="40" VerticalAlignment="Bottom" BorderBrush="#FF3C8F38" Content="{Binding VPNWarningPopupButtonText, Mode=OneWay}" Click="StartVPNClient_Click">
                <Control.Background>
                  <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" />
                    <GradientStop Color="#FF379532" />
                    <GradientStop Color="{DynamicResource BrushLightGreen}" Offset="0.51" />
                  </LinearGradientBrush>
                </Control.Background>
              </Button>
            </DockPanel>
          </Grid>
        </StackPanel>
        <Grid Row="3" Margin="8,8,8,8" />
      </Grid>
    </Border>
    <Path Grid.Row="1" Stroke="#FF000000" Panel.ZIndex="1" Margin="285 -1 5 0" Data="M0,0 L10,10 L20,0 L0,0" StrokeThickness="0" Fill="{StaticResource HighlightBrush}" />
  </Grid>
</UserControl>