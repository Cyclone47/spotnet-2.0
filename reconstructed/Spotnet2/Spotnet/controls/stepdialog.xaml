<Window x:Class="Spotnet.Controls.StepDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" FontSize="14" Title="Spotnet" Width="400" Height="400" WindowStartupLocation="CenterScreen" SizeToContent="Manual" WindowState="Normal" Icon="/Resources\ImagesInternal\spotnet.ico" Cursor="Wait" MaxWidth="500" MaxHeight="500" xmlns:controls="clr-namespace:Spotnet.Controls">
  <Control.Background>
    <LinearGradientBrush EndPoint="0,1" StartPoint="0.5,0">
      <GradientStop Color="#FFEBF3FF" Offset="0.3" />
      <GradientStop Color="#FFBAD7FF" Offset="0.6" />
    </LinearGradientBrush>
  </Control.Background>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Name="ContentRow" Height="*" />
      <RowDefinition Name="ButtonRow" Height="40" />
    </Grid.RowDefinitions>
    <Frame Name="ContentFrame" Grid.ColumnSpan="5" Grid.Row="0" />
    <Button Name="NextButton" Style="{StaticResource StepButton}" Grid.Row="1" Grid.Column="4" Content="{x:Static p:Words.Next}" Width="75" Height="20" Click="NextButton_Click" />
    <Button Name="PrevButton" Style="{StaticResource StepButton}" Grid.Row="1" Grid.Column="3" Content="{x:Static p:Words.Prev}" Width="75" Height="20" Click="PrevButton_Click" />
    <Button Name="FinishButton" Style="{StaticResource StepButton}" Grid.Row="1" Grid.Column="2" Content="{x:Static p:Words.Finish}" Width="75" Height="20" Click="FinishButton_Click" />
    <Button Name="CancelButton" Style="{StaticResource StepButton}" Grid.Row="1" Grid.Column="1" Content="{x:Static p:Words.Cancel}" Width="75" Height="20" Click="CancelButton_Click" />
  </Grid>
</Window>