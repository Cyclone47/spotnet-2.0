<metro:MetroWindow x:Class="Spotnet.Controls.SimpleTextDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" Title="Simple Text Dialog" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" WindowTransitionsEnabled="True" Icon="/Resources/ImagesInternal/smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <Control.Background>
    <LinearGradientBrush EndPoint="0,1" StartPoint="0.5,0">
      <GradientStop Color="#FFEBF3FF" Offset="0.3" />
      <GradientStop Color="#FFBAD7FF" Offset="0.6" />
    </LinearGradientBrush>
  </Control.Background>
  <Grid Margin="20,20,20,20">
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBox Name="MainTextBox" Grid.Row="0" />
    <Grid Row="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Name="OkButton" Grid.Column="1" Content="OK" Margin="0,0" Padding="20,0" IsEnabled="True" Click="OkButton_OnClick" />
    </Grid>
  </Grid>
</metro:MetroWindow>