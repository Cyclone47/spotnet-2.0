<UserControl x:Class="Spotnet.Controls.SettingsVPNProvider" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding DataContext.FontSize, ElementName=VisibilityVmProxy, Mode=OneWay}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="FieldAnimationStoryboard">
        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" From="White" To="OrangeRed" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Orientation="Vertical">
    <StackPanel Orientation="Vertical" Margin="0,7,0,0">
      <TextBlock Text="{x:Static p:Words.VPNProvider}" />
      <ComboBox Name="ProviderBox" SelectionChanged="ProviderBox_OnSelectionChanged" />
    </StackPanel>
    <Separator Name="spacer" Margin="10,10,10,3" />
    <TextBlock Name="VPNNotInstalledText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
      <Run Text="{x:Static p:Words.VPNAppNotInstalled}" /> <Hyperlink NavigateUri="https://www.vpnnederland.nl" TargetName="_blank" RequestNavigate="Hyperlink_RequestNavigate">VPNNederland</Hyperlink> <Run Text="{x:Static p:Words.OrWord}" /> <Hyperlink NavigateUri="https://www.5eurovpn.com" TargetName="_blank" RequestNavigate="Hyperlink_RequestNavigate">5EuroVPN</Hyperlink> <Run Text="{x:Static p:Words.GetOne}" /></TextBlock>
  </StackPanel>
</UserControl>