<metro:MetroWindow x:Class="Spotnet.Controls.ChangeFiltersListWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" Title="{x:Static p:Words.MenuFiltersListChange}" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" WindowTransitionsEnabled="True" Icon="/Resources/ImagesInternal/smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" xmlns:controls="clr-namespace:Spotnet.Controls" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <Control.Background>
    <LinearGradientBrush EndPoint="0,1" StartPoint="0.5,0">
      <GradientStop Color="#FFEBF3FF" Offset="0.3" />
      <GradientStop Color="#FFBAD7FF" Offset="0.6" />
    </LinearGradientBrush>
  </Control.Background>
  <DockPanel FocusManager.FocusedElement="{Binding ElementName=FiltersListCombo}">
    <StackPanel Orientation="Vertical" Margin="20,7,20,0" DockPanel.Dock="Top">
      <ComboBox Name="FiltersListCombo" MinWidth="150" TabIndex="1" />
    </StackPanel>
    <DockPanel Dock="Bottom" Margin="20,0,20,10" HorizontalAlignment="Right">
      <Button Name="OkButton" Width="124" Height="30" IsDefault="True" Content="{x:Static p:Words.Ok}" TabIndex="7" Margin="10,10,10,0" Click="OkButton_Click" />
      <Button Name="CancelButton" Width="124" Height="30" IsEnabled="True" Content="{x:Static p:Words.Cancel}" TabIndex="8" Margin="10,10,0,0" Click="CancelButton_Click" />
    </DockPanel>
  </DockPanel>
</metro:MetroWindow>