<metro:MetroWindow x:Class="Spotnet.Views.SelectProviderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Spotnet.Properties" xmlns:controls="clr-namespace:Spotnet.Controls" xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls" Title="{x:Static p:Words.SelectProvider}" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Topmost="False" GlowBrush="{DynamicResource HighlightBrush}" WindowTransitionsEnabled="True" Icon="/Resources/ImagesInternal/smallspotnet.ico" ShowIconOnTitleBar="False" ShowTitleBar="True" ShowActivated="True" xmlns:views="clr-namespace:Spotnet.Views" FontSize="{Binding ElementName=VisibilityVmProxy, Path=DataContext.FontSize, Mode=OneWay}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="FieldAnimationStoryboard">
        <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" From="White" To="OrangeRed" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Control.Background>
    <LinearGradientBrush EndPoint="0,1" StartPoint="0.5,0">
      <GradientStop Color="#FFEBF3FF" Offset="0.3" />
      <GradientStop Color="#FFBAD7FF" Offset="0.6" />
    </LinearGradientBrush>
  </Control.Background>
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="10,5,10,0" Visibility="Visible">
      <TextBlock Name="TextWithTheLink" FontStyle="Italic" TextWrapping="Wrap" Margin="20,10,20,10" />
    </Grid>
    <Grid DockPanel.Dock="Bottom" Margin="10,5,10,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Name="ProviderLabel" Grid.Row="0" Grid.Column="0" Content="{x:Static p:Words.Provider}" HorizontalAlignment="Left" Margin="20,0,0,0" FontWeight="Bold" />
        <ComboBox Name="ProviderBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="0" Width="218" Height="26" IsReadOnly="True" TabIndex="0" GotFocus="ProviderBox_GotFocus" />
        <Expander Name="AdvancedSettingsExpander" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsExpanded="False" Header="{x:Static p:Words.AdvancedSettings}" Background="#00FFFFFF" BorderBrush="#FF808080" BorderThickness="0.5" Margin="0,10,0,10" Opacity="50">
          <Grid HorizontalAlignment="Left" Height="Auto">
            <Grid.RowDefinitions>
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Content="Headers server" Margin="33,0,0,0" />
            <Border Name="HeaderServerTextBoxBorder" Grid.Row="0" Grid.Column="2" BorderBrush="#00FFFFFF" BorderThickness="2" Width="218">
              <TextBox Name="HeaderServerTextBox" TabIndex="1" ToolTip="{x:Static p:Words.EnterServerAddress}" GotFocus="HeaderServerTextBox_GotFocus" TextChanged="HeaderServerTextBox_TextChanged" />
            </Border>
            <Border Name="HeaderServerPortComboBoxBorder" Grid.Row="0" Grid.Column="3" BorderBrush="#00FFFFFF" BorderThickness="2" Visibility="Visible">
              <ComboBox Name="HeaderServerPortComboBox" IsManipulationEnabled="True" IsEditable="True" TabIndex="2" BorderThickness="1" Height="26" ToolTip="{x:Static p:Words.SelectPort}" GotFocus="HeaderServerPortComboBox_GotFocus" TextBoxBase.TextChanged="HeaderServerPortComboBox_OnTextChanged">
                <ComboBoxItem Content="119" />
                <ComboBoxItem Content="443" />
                <ComboBoxItem Content="563" IsSelected="True" />
                <ComboBoxItem Content="80" />
              </ComboBox>
            </Border>
            <Label HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0" Content="Download server" Margin="33,0,0,0" />
            <Border Name="DownloadServerTextBoxBorder" Grid.Row="1" Grid.Column="2" BorderBrush="#00FFFFFF" BorderThickness="2" Width="218">
              <TextBox Name="DownloadServerTextBox" TabIndex="1" IsEnabled="False" ToolTip="{x:Static p:Words.EnterServerAddress}" GotFocus="DownloadServerTextBox_GotFocus" TextChanged="DownloadServerTextBox_TextChanged" />
            </Border>
            <CheckBox Name="DownloadServerCheckBox" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Checked="DownloadServerCheckBox_OnChecked" Unchecked="DownloadServerCheckBox_OnUnchecked" />
            <Border Name="DownloadServerPortComboBoxBorder" Grid.Row="1" Grid.Column="3" BorderBrush="#00FFFFFF" BorderThickness="2" Visibility="Visible">
              <ComboBox Name="DownloadServerPortComboBox" IsManipulationEnabled="True" IsEditable="True" TabIndex="2" BorderThickness="1" Height="26" IsEnabled="False" ToolTip="{x:Static p:Words.SelectPort}" GotFocus="DownloadServerPortComboBox_GotFocus">
                <ComboBoxItem Content="119" />
                <ComboBoxItem Content="443" />
                <ComboBoxItem Content="563" IsSelected="True" />
                <ComboBoxItem Content="80" />
              </ComboBox>
            </Border>
            <Label HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0" Content="Upload server" Margin="33,0,0,0" />
            <Border Name="UploadServerTextBoxBorder" Grid.Row="2" Grid.Column="2" BorderBrush="#00FFFFFF" BorderThickness="2" Width="218">
              <TextBox Name="UploadServerTextBox" TabIndex="1" IsEnabled="False" ToolTip="{x:Static p:Words.EnterServerAddress}" GotFocus="UploadServerTextBox_GotFocus" TextChanged="UploadServerTextBox_TextChanged" />
            </Border>
            <CheckBox Name="UploadServerCheckBox" Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" Checked="UploadServerCheckBox_OnChecked" Unchecked="UploadServerCheckBox_OnUnchecked" />
            <Border Name="UploadServerPortComboBoxBorder" Grid.Row="2" Grid.Column="3" BorderBrush="#00FFFFFF" BorderThickness="2" Visibility="Visible">
              <ComboBox Name="UploadServerPortComboBox" IsManipulationEnabled="True" IsEditable="True" TabIndex="2" BorderThickness="1" Height="26" IsEnabled="False" ToolTip="{x:Static p:Words.SelectPort}" GotFocus="UploadServerPortComboBox_GotFocus">
                <ComboBoxItem Content="119" />
                <ComboBoxItem Content="443" />
                <ComboBoxItem Content="563" IsSelected="True" />
                <ComboBoxItem Content="80" />
              </ComboBox>
            </Border>
            <Label Name="ConnectionsLabel" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" Content="{x:Static p:Words.Connections}" Margin="33,0,0,0" Width="107" Grid.ColumnSpan="2" />
            <ComboBox Name="ConnectionsCombo" Grid.Row="3" Grid.Column="2" IsEditable="True" IsManipulationEnabled="True" TabIndex="3" Width="214" Height="26" ToolTip="{x:Static p:Words.SelectNumberOfConnections}" Margin="2">
              <ComboBoxItem Content="Auto" IsSelected="True" />
              <ComboBoxItem Content="4" />
              <ComboBoxItem Content="6" />
              <ComboBoxItem Content="8" />
              <ComboBoxItem Content="10" />
              <ComboBoxItem Content="12" />
              <ComboBoxItem Content="16" />
              <ComboBoxItem Content="18" />
              <ComboBoxItem Content="20" />
              <ComboBoxItem Content="30" />
            </ComboBox>
          </Grid>
        </Expander>
        <Label Name="AccountLabel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Content="{x:Static p:Words.Account}" FontWeight="Bold" Margin="20,0,0,0" Width="107" />
        <Label Name="UsernameLabel" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" Margin="40,0,0,0" Content="{x:Static p:Words.Username}" Width="125" />
        <Border Name="UserNameTextBoxBorder" BorderBrush="#00FFFFFF" Grid.Row="3" Grid.Column="1" Width="218" BorderThickness="2">
          <TextBox Name="UserNameTextBox" TabIndex="5" ToolTip="{x:Static p:Words.EnterUsername}" GotFocus="UserNameTextBox_GotFocus" TextChanged="UserNameTextBox_OnTextChanged" />
        </Border>
        <Label Name="PasswordLabel" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" Margin="40,0,0,0" Content="{x:Static p:Words.Password}" Width="107" />
        <Border Name="PasswordTextBoxBorder" BorderBrush="#00FFFFFF" Grid.Row="4" Grid.Column="1" BorderThickness="2" Width="218">
          <PasswordBox Name="PasswordTextBox" TabIndex="6" ToolTip="{x:Static p:Words.EnterPassword}" GotFocus="PasswordTextBox_GotFocus" PasswordChanged="PasswordTextBox_OnPasswordChanged" />
        </Border>
        <DockPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
          <Button Name="ConnectButton" Width="124" IsDefault="True" IsEnabled="False" TabIndex="7" Margin="10,10,10,0" Click="ConnectButton_Click">
            <Grid>
              <controls:ProgressRing x:Name="ConnectProgressRing" IsActive="False" Margin="0" HorizontalAlignment="Left" Width="15" Height="15" />
              <Label Content="{x:Static p:Words.Connect}" Margin="25,0,0,0" />
            </Grid>
          </Button>
          <Button Name="CancelButton" Width="124" IsEnabled="True" Content="{x:Static p:Words.Cancel}" TabIndex="8" Margin="10,10,10,0" Click="CancelButton_Click" />
          <TextBox Name="HiddenPortTextBox" Visibility="Collapsed" Text="{Binding Text, ElementName=HeaderServerPortComboBox}" TextChanged="HiddenPortTextBox_OnTextChanged" />
          <TextBox Name="HiddenConnectionsTextBox" Visibility="Collapsed" Text="{Binding Text, ElementName=ConnectionsCombo}" TextChanged="HiddenConnectionsTextBox_OnTextChanged" />
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</metro:MetroWindow>