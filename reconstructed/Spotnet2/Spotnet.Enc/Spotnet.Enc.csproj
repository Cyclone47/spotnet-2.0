<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral. SpotnetDecoder is pure byte arithmetic over System and
    System.Runtime.CompilerServices, so it targets PortableTargetFramework and builds
    AnyCPU: the old x64 PlatformTarget would have refused to load on Apple Silicon.
    The WPF client still consumes it unchanged - a net8.0 library is referenceable
    from net8.0-windows.
  -->
  <PropertyGroup>
    <TargetFramework>$(PortableTargetFramework)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Spotnet.Enc</AssemblyName>
    <RootNamespace>SpotnetEnc</RootNamespace>
  </PropertyGroup>

</Project>
